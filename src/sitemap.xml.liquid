---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for item in collections.sitemapPages -%}
    <url>
      <loc>{{ site.url }}{{ item.url }}</loc>
      <lastmod>{{ item.date | isoDate }}</lastmod>
      <changefreq>{{ item.data.changefreq | default: "weekly" }}</changefreq>
      <priority>{% if item.url == "/" %}1.0{% else %}{{ item.data.priority | default: "0.8" }}{% endif %}</priority>
    </url>
  {%- endfor -%}
</urlset>