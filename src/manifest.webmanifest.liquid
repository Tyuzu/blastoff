---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
layout: null
---
{
  "name": "{{ site.name }} - Online Image, Video & PDF Tools",
  "short_name": "{{ site.shortName | default: site.name }}",
  "description": "{{ site.description }}",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "{{ site.backgroundColor | default: '#ffffff' }}",
  "theme_color": "{{ site.themeColor | default: '#0f172a' }}",
  "categories": ["utilities", "productivity", "photo", "video"],
  "icons": [
    {
      "src": "/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Image Tools",
      "short_name": "Images",
      "description": "Convert, resize, and compress images",
      "url": "/image-tools/?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Video Tools",
      "short_name": "Videos",
      "description": "Trim, convert, and filter videos",
      "url": "/video-tools/?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "PDF Tools",
      "short_name": "PDFs",
      "description": "Merge, split, and scan PDFs",
      "url": "/pdf-tools/?source=pwa-shortcut",
      "icons": [{ "src": "/assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}