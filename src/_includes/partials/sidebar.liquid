{%- if sidebar -%}

  {%- assign sidebarHeadingId = 'sidebar-heading' -%}

  <aside
    class="site-sidebar"
    {% if sidebar.title %}aria-labelledby="{{ sidebarHeadingId }}"{% else %}aria-label="Sidebar navigation"{% endif %}>

    <div class="sidebar-inner">

      {%- if sidebar.title -%}
        <h2 class="sidebar-title" id="{{ sidebarHeadingId }}">{{ sidebar.title }}</h2>
      {%- endif -%}

      <nav aria-label="{{ sidebar.title | default: 'Section' }} links">
        <ul class="sidebar-menu">

          {%- for item in sidebar.items -%}

            {%- assign isCurrent = false -%}
            {%- if page.url == item.url -%}
              {%- assign isCurrent = true -%}
            {%- endif -%}

            {%- assign hasActiveDescendant = false -%}
            {%- if item.children -%}
              {%- for child in item.children -%}
                {%- if page.url == child.url -%}
                  {%- assign hasActiveDescendant = true -%}
                {%- endif -%}
                {%- if child.children -%}
                  {%- for subchild in child.children -%}
                    {%- if page.url == subchild.url -%}
                      {%- assign hasActiveDescendant = true -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            <li class="sidebar-item{% if item.children %} has-children{% endif %}{% if isCurrent or hasActiveDescendant %} active{% endif %}">

              <a
                href="{{ item.url }}"
                {% if isCurrent %}aria-current="page"{% endif %}
                {% if item.titleAttr %}title="{{ item.titleAttr }}"{% endif %}>
                {{ item.title }}
              </a>

              {%- if item.children -%}

                <ul class="sidebar-submenu">

                  {%- for child in item.children -%}

                    {%- assign isChildCurrent = false -%}
                    {%- if page.url == child.url -%}
                      {%- assign isChildCurrent = true -%}
                    {%- endif -%}

                    {%- assign hasActiveSubchild = false -%}
                    {%- if child.children -%}
                      {%- for subchild in child.children -%}
                        {%- if page.url == subchild.url -%}
                          {%- assign hasActiveSubchild = true -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}

                    <li class="sidebar-subitem{% if child.children %} has-children{% endif %}{% if isChildCurrent or hasActiveSubchild %} active{% endif %}">

                      <a
                        href="{{ child.url }}"
                        {% if isChildCurrent %}aria-current="page"{% endif %}
                        {% if child.titleAttr %}title="{{ child.titleAttr }}"{% endif %}>
                        {{ child.title }}
                      </a>

                      {%- if child.children -%}

                        <ul class="sidebar-submenu-level-3">

                          {%- for subchild in child.children -%}

                            {%- assign isSubchildCurrent = false -%}
                            {%- if page.url == subchild.url -%}
                              {%- assign isSubchildCurrent = true -%}
                            {%- endif -%}

                            <li class="sidebar-subitem-level-3{% if isSubchildCurrent %} active{% endif %}">
                              <a
                                href="{{ subchild.url }}"
                                {% if isSubchildCurrent %}aria-current="page"{% endif %}
                                {% if subchild.titleAttr %}title="{{ subchild.titleAttr }}"{% endif %}>
                                {{ subchild.title }}
                              </a>
                            </li>

                          {%- endfor -%}

                        </ul>

                      {%- endif -%}

                    </li>

                  {%- endfor -%}

                </ul>

              {%- endif -%}

            </li>

          {%- endfor -%}

        </ul>
      </nav>

    </div>

  </aside>

{%- endif -%}