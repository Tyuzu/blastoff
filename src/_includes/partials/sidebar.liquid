
{% if sidebar %}

<aside class="site-sidebar"
       aria-label="Sidebar navigation">

  <div class="sidebar-inner">

    {% if sidebar.title %}
      <h2>{{ sidebar.title }}</h2>
    {% endif %}

    <ul class="sidebar-menu">

      {% for item in sidebar.items %}

        <li class="sidebar-item">

          <a href="{{ item.url }}"
             {% if page.url == item.url %}
               aria-current="page"
             {% endif %}>

            {{ item.title }}

          </a>

          {% if item.children %}

            <ul class="sidebar-submenu">

              {% for child in item.children %}

                <li>

                  <a href="{{ child.url }}">
                    {{ child.title }}
                  </a>

                  {% if child.children %}

                    <ul class="sidebar-submenu-level-3">

                      {% for subchild in child.children %}

                        <li>
                          <a href="{{ subchild.url }}">
                            {{ subchild.title }}
                          </a>
                        </li>

                      {% endfor %}

                    </ul>

                  {% endif %}

                </li>

              {% endfor %}

            </ul>

          {% endif %}

        </li>

      {% endfor %}

    </ul>

  </div>

</aside>

{% endif %}
