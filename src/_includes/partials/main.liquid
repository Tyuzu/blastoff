
<main id="main-content" class="site-main">

  {% if showPageTitle != false %}

    <header class="page-header">

      <h1>{{ title }}</h1>

      {% if description %}
        <p>{{ description }}</p>
      {% endif %}

    </header>

  {% endif %}

  <div class="page-content">

    {{ content }}

  </div>

</main>
