
<div
  class="modal"
  id="global-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
  hidden>

  <div class="modal-overlay" data-modal-close></div>

  <div class="modal-dialog">

    <div class="modal-header">

      <h2 id="modal-title">
        {{ modalTitle | default: "Information" }}
      </h2>

      <button
        type="button"
        class="modal-close"
        aria-label="Close modal"
        data-modal-close>
        &times;
      </button>

    </div>

    <div class="modal-body" id="modal-content">

      {{ modalContent }}

    </div>

  </div>

</div>
