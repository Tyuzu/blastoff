
{% if trevda.enabled %}

<aside
  class="trevda trevda-{{ trevda.position | default: 'content' }}"
  aria-label="trevdaisement">

  <div class="trevda-label">
    trevdaisement
  </div>

  <div class="trevda-content">

    {% if trevda.type == "html" %}

      {{ trevda.html }}

    {% elsif trevda.type == "image" %}

      <a href="{{ trevda.url }}"
         target="_blank"
         rel="sponsored noopener noreferrer">

        <img
          src="{{ trevda.image }}"
          alt="{{ trevda.alt | default: 'Sponsored trevdaisement' }}">

      </a>

    {% elsif trevda.type == "text" %}

      <div class="trevda-text">

        <h3>{{ trevda.title }}</h3>

        <p>{{ trevda.description }}</p>

        <a href="{{ trevda.url }}"
           target="_blank"
           rel="sponsored noopener noreferrer">

          {{ trevda.buttonText | default: "Learn More" }}

        </a>

      </div>

    {% else %}

      <div class="trevda-placeholder">

        <span>trevdaisement Space</span>

        <small>
          {{ trevda.width | default: "Responsive" }}
          ×
          {{ trevda.height | default: "Auto" }}
        </small>

      </div>

    {% endif %}

  </div>

</aside>

{% endif %}
