
<footer class="site-footer">

  <div class="footer-inner">

    <div class="footer-branding">
      <h2>{{ site.name }}</h2>
      <p>{{ site.description }}</p>
    </div>

    <nav aria-label="Footer navigation">

      <ul>

        {% for item in navigation.footer %}

          <li>
            <a href="{{ item.url }}">
              {{ item.title }}
            </a>
          </li>

        {% endfor %}

      </ul>

    </nav>

    <div class="footer-bottom">

      <p>
        &copy; {{ "now" | date: "%Y" }}
        {{ site.name }}.
        All rights reserved.
      </p>

    </div>

  </div>

</footer>
