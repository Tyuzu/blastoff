<nav
  class="primary-nav"
  id="primary-navigation"
  aria-label="Primary navigation">

  <ul class="nav-list">

    {%- for item in navigation.primary -%}

      {%- assign isCurrent = false -%}
      {%- if page.url == item.url -%}
        {%- assign isCurrent = true -%}
      {%- endif -%}

      {%- assign hasActiveChild = false -%}
      {%- if item.children -%}
        {%- for child in item.children -%}
          {%- if page.url == child.url -%}
            {%- assign hasActiveChild = true -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}

      {%- assign submenuId = 'submenu-' | append: forloop.index -%}

      <li class="nav-item{% if item.children %} has-dropdown{% endif %}{% if isCurrent or hasActiveChild %} active{% endif %}">

        <a
          href="{{ item.url }}"
          {% if isCurrent %}aria-current="page"{% endif %}
          {% if item.titleAttr %}title="{{ item.titleAttr }}"{% endif %}>
          {{ item.title }}
        </a>

        {%- if item.children -%}

          <button
            type="button"
            class="dropdown-toggle"
            aria-expanded="false"
            aria-controls="{{ submenuId }}"
            aria-label="Toggle {{ item.title }} submenu">
            <span aria-hidden="true">+</span>
          </button>

          <ul class="dropdown-menu" id="{{ submenuId }}">

            {%- for child in item.children -%}
              {%- assign isChildCurrent = false -%}
              {%- if page.url == child.url -%}
                {%- assign isChildCurrent = true -%}
              {%- endif -%}

              <li{% if isChildCurrent %} class="active"{% endif %}>
                <a
                  href="{{ child.url }}"
                  {% if isChildCurrent %}aria-current="page"{% endif %}
                  {% if child.titleAttr %}title="{{ child.titleAttr }}"{% endif %}>
                  {{ child.title }}
                </a>
              </li>

            {%- endfor -%}

          </ul>

        {%- endif -%}

      </li>

    {%- endfor -%}

  </ul>

</nav>