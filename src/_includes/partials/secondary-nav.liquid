{%- if secondaryNavigation -%}

  <nav
    class="secondary-nav"
    aria-label="{{ secondaryNavigationLabel | default: 'Section navigation' }}">

    <ul class="secondary-nav-inner">

      {%- for item in secondaryNavigation -%}

        {%- assign isCurrent = false -%}
        {%- if page.url == item.url -%}
          {%- assign isCurrent = true -%}
        {%- endif -%}

        <li class="secondary-nav-list-item{% if isCurrent %} active{% endif %}">
          <a
            href="{{ item.url }}"
            class="secondary-nav-item{% if isCurrent %} active{% endif %}"
            {% if isCurrent %}aria-current="page"{% endif %}
            {% if item.titleAttr %}title="{{ item.titleAttr }}"{% endif %}>
            {{ item.title }}
          </a>
        </li>

      {%- endfor -%}

    </ul>

  </nav>

{%- endif -%}