---
layout: layout.liquid
permalink: /tags/
pageTitle: Categories & Tags
description: Browse all tags and categories across the site.
---
{%- assign ignored_tags = "all,pages,nav,posts,tagList" | split: "," -%}

<section class="tags-index" aria-labelledby="tags-index-heading">
  <header class="tags-index__header">
    <h1 id="tags-index-heading" class="tags-index__title">{{ pageTitle | escape }}</h1>
    {%- if collections.tagList and collections.tagList.size > 0 -%}
      <p class="tags-index__summary">
        {{ collections.tagList.size }} {% if collections.tagList.size == 1 %}tag{% else %}tags{% endif %} available
      </p>
    {%- endif -%}
  </header>

  {%- if collections.tagList and collections.tagList.size > 0 -%}
    <ul class="tags-index__list">
      {%- for tag in collections.tagList -%}
        {%- unless ignored_tags contains tag -%}
          {%- assign tag_slug = tag | slugify -%}
          {%- assign tag_url = '/tags/' | append: tag_slug | append: '/' -%}
          {%- assign item_count = 0 -%}
          {%- if collections[tag] -%}
            {%- assign item_count = collections[tag].size -%}
          {%- endif -%}

          <li class="tags-index__item">
            <a href="{{ tag_url | escape }}" class="tags-index__link">
              <span class="tags-index__name">
                <span class="tags-index__hash" aria-hidden="true">#</span>{{ tag | escape }}
              </span>
              <span class="tags-index__count">
                {{ item_count }} {% if item_count == 1 %}item{% else %}items{% endif %}
              </span>
            </a>
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="tags-index__empty">No tags found yet.</p>
  {%- endif -%}
</section>