{%- assign raw_active_url = url | default: page.url | default: '/' -%}
{%- assign clean_url = raw_active_url | split: '?' | first | split: '#' | first -%}
{%- if clean_url == blank -%}
  {%- assign clean_url = '/' -%}
{%- endif -%}

{%- assign active_url = clean_url -%}
{%- unless active_url == '/' -%}
  {%- assign first_char = active_url | slice: 0, 1 -%}
  {%- unless first_char == '/' -%}
    {%- assign active_url = active_url | prepend: '/' -%}
  {%- endunless -%}
  {%- assign last_char = active_url | slice: -1, 1 -%}
  {%- unless last_char == '/' -%}
    {%- assign active_url = active_url | append: '/' -%}
  {%- endunless -%}
{%- endunless -%}

{%- assign ignored_tags = "all,pages,nav,posts,tagList,tags" | split: "," -%}

{%- if tags != blank and tags.size > 0 -%}
  {%- assign tag_source = tags -%}
{%- else -%}
  {%- assign tag_source = collections -%}
{%- endif -%}

{%- capture tag_items_html -%}
  {%- for item in tag_source -%}
    {%- assign tag = item[0] | default: item -%}
    {%- unless ignored_tags contains tag -%}
      {%- assign tag_slug = tag | slugify -%}
      {%- assign tag_url = '/tags/' | append: tag_slug | append: '/' -%}
      {%- assign page_prefix = tag_url | append: 'page/' -%}

      {%- assign is_active = false -%}
      {%- if active_url == tag_url -%}
        {%- assign is_active = true -%}
      {%- else -%}
        {%- assign prefix_check = active_url | slice: 0, page_prefix.size -%}
        {%- if prefix_check == page_prefix -%}
          {%- assign is_active = true -%}
        {%- endif -%}
      {%- endif -%}

      {%- assign tag_count = nil -%}
      {%- if collections and collections[tag] -%}
        {%- assign tag_count = collections[tag].size -%}
      {%- endif -%}

      <li class="sidebar__item">
        <a
          href="{{ tag_url | escape }}"
          class="sidebar__link{% if is_active %} is-active{% endif %}"
          {% if is_active %}aria-current="page"{% endif %}
        >
          <span class="sidebar__tag-label">
            <span class="sidebar__tag-hash" aria-hidden="true">#</span>{{ tag | escape }}
          </span>
          {%- if tag_count != nil -%}
            <span class="sidebar__count">{{ tag_count }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign clean_tag_items = tag_items_html | strip -%}

<aside class="sidebar" aria-label="Sidebar navigation">
  <div class="sidebar__section">
    <h2 class="sidebar__heading">Categories &amp; Tags</h2>

    {%- if clean_tag_items != blank -%}
      <ul class="sidebar__list">
        <li class="sidebar__item">
          <a
            href="/"
            class="sidebar__link{% if active_url == '/' %} is-active{% endif %}"
            {% if active_url == '/' %}aria-current="page"{% endif %}
          >
            <span class="sidebar__tag-label">All Items</span>
          </a>
        </li>

        <li class="sidebar__item">
          <a
            href="/tags/"
            class="sidebar__link{% if active_url == '/tags/' %} is-active{% endif %}"
            {% if active_url == '/tags/' %}aria-current="page"{% endif %}
          >
            <span class="sidebar__tag-label">All Tags</span>
            {%- if tags and tags.size > 0 -%}
              <span class="sidebar__count">{{ tags.size }}</span>
            {%- endif -%}
          </a>
        </li>

        {{ clean_tag_items }}
      </ul>
    {%- else -%}
      <p class="sidebar__empty">No categories available.</p>
    {%- endif -%}
  </div>
</aside>