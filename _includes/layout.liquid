<!DOCTYPE html>
<html lang="{{ lang | default: site.lang | default: 'en' }}">
<head>
  {%- assign resolvedTitle = title | default: pageTitle | default: site.title -%}
  {%- assign resolvedDescription = description | default: site.description -%}
  {%- render 'partials/head.liquid', pageTitle: resolvedTitle, description: resolvedDescription, styles: styles, scripts: scripts, page: page, site: site -%}
</head>
<body class="layout">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="brand" href="/" aria-label="PicOK home"><span class="brand-mark">P</span><span>Pic<span>OK</span></span></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav">Menu</button>
      <div id="primary-nav" class="nav-wrap">{%- render 'partials/nav.liquid', currentUrl: page.url -%}</div>
    </div>
  </header>
  <main id="main-content" class="site-main">{{ content }}</main>
  <footer class="site-footer"><div class="footer-inner"><a class="brand" href="/"><span class="brand-mark">P</span><span>Pic<span>OK</span></span></a><p>Simple file conversions. No account. No fuss.</p><span>© {{ "now" | date: "%Y" }} PicOK</span></div></footer>
  <script>
  (()=>{const b=document.querySelector('.menu-toggle'),n=document.querySelector('.nav-wrap');if(b&&n)b.addEventListener('click',()=>{const v=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!v));n.classList.toggle('open',!v)})})();
  </script>
</body>
</html>