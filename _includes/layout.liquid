<!DOCTYPE html>
<html lang="{{ lang | default: site.lang | default: 'en' }}">
<head>
  {%- assign resolvedTitle = title | default: pageTitle | default: site.title -%}
  {%- assign resolvedDescription = description | default: site.description -%}
  {%- render 'partials/head.liquid',
    pageTitle: resolvedTitle,
    description: resolvedDescription,
    styles: styles,
    scripts: scripts,
    page: page,
    site: site
  -%}
</head>
<body class="layout">
  <a href="#main-content" class="skip-link">Skip to content</a>

  {%- render 'partials/header.liquid',
    siteTitle: site.title,
    site: site,
    page: page,
    pages: pages,
    navigation: navigation,
    currentUrl: page.url
  -%}

  <main id="main-content" class="site-main">
    {{ content }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <a class="brand" href="/">
        <span class="brand-mark">P</span><span>Pic<span>OK</span></span>
      </a>
      <p>Simple file conversions. No account. No fuss.</p>
      <span>&copy; {{ "now" | date: "%Y" }} PicOK</span>
    </div>
  </footer>

  <script>
    (() => {
      const header = document.querySelector('.site-header');
      if (!header) return;

      const toggle = header.querySelector('.menu-toggle');
      const nav = header.querySelector('#primary-nav');
      if (!toggle || !nav) return;

      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        nav.classList.toggle('open', !expanded);
      });
    })();
  </script>
</body>
</html>